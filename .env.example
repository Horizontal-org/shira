# Set your domain names here
SPACES_DOMAIN=spaces.shira.app
QUIZ_DOMAIN=quiz.shira.app
IMAGES_DOMAIN=images.shira.app
COOKIE_DOMAIN=shira.app
VERSION=latest

# Generate these secrets
JWT_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# Must be generated with: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Fill these after image server first run (see README)
IMAGE_ACCESS_KEY=
IMAGE_SECRET_KEY=

# Your SMTP options, FROM is also used to receive Let's Encrypt
# notifications
SMTP_GLOBAL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

TZ=UTC
MYSQL_HOST=db
MYSQL_DATABASE=shira
MYSQL_USER=shira
REDIS_HOST=redis
IMAGE_ENDPOINT=$IMAGES_DOMAIN
IMAGE_PORT=443
IMAGE_BUCKET=shira
SUBSCRIPTION_CACHE_TTL=300

SPACE_URL=https://$SPACES_DOMAIN
PUBLIC_URL=https://$QUIZ_DOMAIN
SHIRA_LIBRARY_URL=https://space.shira.app/library-api
SUPERADMIN_URL=

# SELF-HOSTED MODE
SELF_HOSTED=true

# PUBLIC LIBRARY
# Controls whether this instance can pull quiz/question templates from the
# public library (SHIRA_LIBRARY_URL). Set to false on self-hosted instances
# that don't want to depend on the public library service. Defaults to true.
ENABLE_PUBLIC_LIBRARY=true

# Change to true if Shira is going to be behind a reverse proxy
TRUST_DOWNSTREAM_PROXY=false
