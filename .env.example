# Set your domain names here
SPACES_DOMAIN=spaces.shira.app
QUIZ_DOMAIN=quiz.shira.app
COOKIE_DOMAIN=shira.app
VERSION=latest

# Generate these secrets
JWT_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# Must be generated with: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Fill these after image server first run (see README)
IMAGE_ACCESS_KEY=
IMAGE_SECRET_KEY=

# Your SMTP options, FROM is also used to receive Let's Encrypt
# notifications
SMTP_GLOBAL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

TZ=UTC
MYSQL_HOST=db
MYSQL_DATABASE=shira
MYSQL_USER=shira
REDIS_HOST=redis
IMAGE_ENDPOINT=images
IMAGE_PORT=3900
IMAGE_BUCKET=shira
SUBSCRIPTION_CACHE_TTL=300

# These can be empty
SPACE_URL=
PUBLIC_URL=
SUPERADMIN_URL=
SHIRA_LIBRARY_URL=https://library.shira.app
