# Set your domain names here
SPACES_DOMAIN=spaces.shira.app
QUIZ_DOMAIN=quiz.shira.app
IMAGES_DOMAIN=images.shira.app
COOKIE_DOMAIN=shira.app
VERSION=development

# Generate these secrets
JWT_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# Must be generated with: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Fill these after image server first run (see README)
IMAGE_ACCESS_KEY=
IMAGE_SECRET_KEY=

# Your SMTP options, FROM is also used to receive Let's Encrypt
# notifications
SMTP_GLOBAL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

TZ=UTC
MYSQL_HOST=db
MYSQL_DATABASE=shira
MYSQL_USER=shira
REDIS_HOST=redis
IMAGE_ENDPOINT=$IMAGES_DOMAIN
IMAGE_PORT=443
IMAGE_BUCKET=shira
SUBSCRIPTION_CACHE_TTL=300

SPACE_URL=https://$SPACES_DOMAIN
PUBLIC_URL=https://$QUIZ_DOMAIN
SHIRA_LIBRARY_URL=https://space.shira.app/library-api
SHIRA_LIBRARY_IMAGES_URL=https://images.shira.app/library-prod-bucket
SUPERADMIN_URL=

# SELF-HOSTED MODE
SELF_HOSTED=true

# PUBLIC LIBRARY
# Controls whether this instance can pull quiz/question templates from, and
# publish quizzes/questions to, the public library (SHIRA_LIBRARY_URL). Set to
# false to keep quiz content inside this instance. Only "true" or "false" are
# accepted. Any other value disables it. When unset, it defaults to true, or to
# false if SELF_HOSTED=true.
ENABLE_PUBLIC_LIBRARY=true

# Change to true if Shira is going to be behind a reverse proxy
TRUST_DOWNSTREAM_PROXY=false

# Proxies between clients and the API, used to read the real client IP for
# rate limiting. Keep 1 with the bundled nginx; set to 2 if you also put your
# own reverse proxy in front of it.
TRUST_PROXY_HOPS=1

# QUIZ RUNS
# Max quiz runs a single IP can start per hour. Defaults to 60.
QUIZ_RUN_START_LIMIT_PER_HOUR=60

# IMPORTS
# Max questions a quiz import ZIP can declare. Defaults to 100.
QUIZ_IMPORT_MAX_QUESTIONS=100
# Max explanations per imported question. Defaults to 50.
QUESTION_IMPORT_MAX_EXPLANATIONS=50
# Max entries, files and folders, in an import ZIP. Defaults to 5000.
IMPORT_MAX_ZIP_ENTRIES=5000
# Max imports, quiz or question, a single IP can run per hour. Defaults to 20.
IMPORT_LIMIT_PER_HOUR=20

# LEARNER QUIZ LINKS
# Days a learner quiz link (sent by email on assignment) stays valid.
# To send a new link, unassign the learner and assign the quiz again.
# Defaults to 30.
LEARNER_QUIZ_LINK_TTL_DAYS=30
