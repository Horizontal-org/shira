# garage credentials
IMAGE_ENDPOINT=
IMAGE_PORT=
IMAGE_BUCKET=
IMAGE_ACCESS_KEY=
IMAGE_SECRET_KEY=

SUBSCRIPTION_CACHE_TTL=

# FRONT DOMAINS
SPACE_URL=
PUBLIC_URL=
SUPERADMIN_URL=

# SHIRA PAYMENTS
INTERNAL_SHIRA_API_KEY=
SHIRA_PAYMENTS_URL=
SHIRA_LIBRARY_URL=

# SELF-HOSTED MODE
SELF_HOSTED=false

# PUBLIC LIBRARY
# Controls whether this instance can pull quiz/question templates from the
# public library (SHIRA_LIBRARY_URL). Set to false on self-hosted instances
# that don't want to depend on the public library service. Defaults to true.
ENABLE_PUBLIC_LIBRARY=true

# QUIZ RUNS
# Max quiz runs a single IP can start per hour. Defaults to 60.
QUIZ_RUN_START_LIMIT_PER_HOUR=60

# IMPORTS
# Max questions a quiz import ZIP can declare. Defaults to 100.
QUIZ_IMPORT_MAX_QUESTIONS=100
# Max explanations per imported question. Defaults to 50.
QUESTION_IMPORT_MAX_EXPLANATIONS=50
# Max entries (files and folders) in an import ZIP. Defaults to 5000.
IMPORT_MAX_ZIP_ENTRIES=5000
# Max imports (quiz or question) a single IP can run per hour. Defaults to 20.
IMPORT_LIMIT_PER_HOUR=20

#CORS
COOKIE_DOMAIN=
