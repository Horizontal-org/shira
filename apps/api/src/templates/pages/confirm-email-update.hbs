{{#> layout }}
  <div>
    <p style="margin-bottom: 4px;">
      Hello,
    </p>
    <p>
      We received a request to change your Shira account email to {{ newEmail }}.
    </p>
    <p>
      If you made this request, click the link below to confirm the change:
    </p>
    <p>
      <a href="{{ confirmLink }}" target="_blank">Confirm your email change</a>
    </p>
    <p>
      If you did not request this change, you can safely ignore this email.
    </p>
  </div>
{{/layout }}
